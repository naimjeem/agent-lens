# Server
PORT=3456

# === Per-agent data directories (override defaults) ===
# Leave unset to use the default for each agent.
CLAUDE_DIR=/Users/yourname/.claude
CODEX_DIR=/Users/yourname/.codex
GEMINI_DIR=/Users/yourname/.gemini
OPENCODE_DIR=/Users/yourname/.local/share/opencode
KIMI_DIR=/Users/yourname/.kimi
CURSOR_DIR=/Users/yourname/.cursor
ANTIGRAVITY_DIR=/Users/yourname/.gemini/antigravity

# === Pricing (USD per 1 million tokens) ===
# Claude (defaults match Bedrock cross-region ap-southeast-2)
# Anthropic API rates: RATE_INPUT=15, RATE_OUTPUT=75, RATE_CACHE_READ=1.5, RATE_CACHE_CREATE=18.75
RATE_INPUT=5.0
RATE_OUTPUT=25.0
RATE_CACHE_READ=0.5
RATE_CACHE_CREATE=6.25

# Codex (OpenAI)
RATE_CODEX_INPUT=1.25
RATE_CODEX_OUTPUT=10.0
RATE_CODEX_CACHE_READ=0.125
RATE_CODEX_CACHE_CREATE=0

# Gemini (Google)
RATE_GEMINI_INPUT=1.25
RATE_GEMINI_OUTPUT=10.0
RATE_GEMINI_CACHE_READ=0.31
RATE_GEMINI_CACHE_CREATE=0

# OpenCode (multi-provider; uses message.cost when present)
RATE_OPENCODE_INPUT=3.0
RATE_OPENCODE_OUTPUT=15.0
RATE_OPENCODE_CACHE_READ=0.3
RATE_OPENCODE_CACHE_CREATE=3.75

# Kimi (Moonshot)
RATE_KIMI_INPUT=0.55
RATE_KIMI_OUTPUT=2.20
RATE_KIMI_CACHE_READ=0.15
RATE_KIMI_CACHE_CREATE=0

# Cursor / Antigravity store opaque chat blobs — token usage not derivable.
# Rates left at 0 by default; set if you have a way to estimate.
RATE_CURSOR_INPUT=0
RATE_CURSOR_OUTPUT=0
RATE_ANTIGRAVITY_INPUT=0
RATE_ANTIGRAVITY_OUTPUT=0
